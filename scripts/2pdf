#!/usr/bin/env bash

print_usage() {
  >&2 echo "Usage: $(basename "$0") INPUT_FILE [portrait|landscape]"
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  print_usage
  exit 1
fi

input_file=$1
orientation=${2:-portrait}

if ! command -v pandoc &>/dev/null || [ ! -x /Library/TeX/texbin/xetex ]; then
  >&2 echo "pandoc or xetex (basictex) not found"
  exit 1
fi

if [ ! -f "$input_file" ]; then
  >&2 echo "Input file not found: $input_file"
  exit 1
fi

if [ "$orientation" != "portrait" ] && [ "$orientation" != "landscape" ]; then
  print_usage
  exit 1
fi

input_name=${input_file##*/}
output_stem=${input_name%.*}
if [ -z "$output_stem" ]; then
  output_stem=$input_name
fi
output_file="${output_stem}.pdf"

pandoc "$input_file" \
  --output="$output_file" \
  --pdf-engine=xelatex \
  --variable="mainfont:TeX Gyre Heros" \
  --variable="geometry:a4paper,$orientation,margin=1.5cm" \
  --variable="fontsize=10pt" \
  --variable='header-includes:\AtBeginDocument{\raggedright}'
